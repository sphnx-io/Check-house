# ── BSC Portal ──────────────────────────────────────────────
BSC_LOGIN_URL=https://bsc.rms-inc.com/page/login
BSC_USERNAME=your_bsc_username
# Current password (optional). If specified, the script first tries a 
# direct connection and only uses the "Forgot Password" flow in case of failure. 
# After each successful reset, the script updates this file automatically.
BSC_PASSWORD=""

# ── Gmail IMAP (to recover the temporary password) ──
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   # Google App Password (16 chars)

# ── Notification email (SMTP via Gmail) ─────────────────────
NOTIFY_EMAIL=your@gmail.com        # Address that receives alerts

# ── Watched houses ──────────────────────────────────────
# Exact names as they appear on the site, separated by commas
PREFERRED_HOUSES=Hillegass Parker,Convent,Ridge House,Kingman Hall,Euclid Hall,Davis House,Kidd Hall
CHECK_INTERVAL_MINUTES=25
# ── Debug Mode ───────────────────────────────────────────────
# 1 = Navigator visible (to inspect selectors), 0 = headless
DEBUG=0

# ── Telegram notifications (phase 2) ────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
