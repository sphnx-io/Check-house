# ── BSC Portal ──────────────────────────────────────────────
BSC_LOGIN_URL=https://bsc.rms-inc.com/page/login
BSC_USERNAME=your_bsc_username
# Mot de passe actuel (optionnel). Si renseigné, le script essaie d'abord une
# connexion directe et n'utilise le flow "Forgot Password" qu'en cas d'échec.
# Après chaque reset réussi, le script met à jour ce fichier automatiquement.
BSC_PASSWORD=""

# ── Gmail IMAP (pour récupérer le mot de passe temporaire) ──
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   # Mot de passe d'application Google (16 chars)

# ── Notification email (SMTP via Gmail) ─────────────────────
NOTIFY_EMAIL=your@gmail.com        # Adresse qui reçoit les alertes

# ── Maisons surveillées ──────────────────────────────────────
# Noms exacts tels qu'ils apparaissent sur le site, séparés par des virgules
PREFERRED_HOUSES=Hillegass Parker,Convent,Ridge House,Kingman Hall,Euclid Hall,Davis House,Kidd Hall
CHECK_INTERVAL_MINUTES=25
# ── Mode debug ───────────────────────────────────────────────
# 1 = navigateur visible (pour inspecter les sélecteurs), 0 = headless
DEBUG=0

# ── Notifications Telegram (phase 2) ────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
